{
  "name": "Simplex Video Studio",
  "short_name": "Video Studio",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f7fa",
  "theme_color": "#0d304d",
  "description": "Generatore video privato SimplexApp collegato alla Venice API",
  "icons": [
    {
      "src": "../assets/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "../assets/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://simplexapp.it/video/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false
}
